# Configurazione personale: contiene il TUO piano e quanto paghi.
# Nel repo c'è config.example.json: copialo in config.json e modificalo.
config.json

# Cache derivata dai transcript. Contiene titoli delle conversazioni, percorsi,
# uuid di sessione e i tuoi orari di lavoro: non deve MAI finire in un repo.
.cache.json

# Bytecode: incorpora i percorsi assoluti della macchina che l'ha generato.
__pycache__/
*.py[cod]

# Stato locale di Claude Code (permessi per macchina, lock con pid e sessione)
.claude/settings.local.json
.claude/*.lock

# Esportazioni: sono conversazioni vere
*.md.export
conversazioni/

# Schermate non trattate: mostrano nomi di progetti, titoli e percorsi reali.
# Quelle pubblicabili, con i dati offuscati, stanno in docs/.
screen/

# Documenti interni all'azienda: assetti organizzativi, valutazioni sul
# trattamento dei dati dei dipendenti, casi reali di dati personali trovati.
# Questo repo e' pubblico: qui dentro non deve finire nulla di tutto cio'.
interno/

# Archivio della telemetria raccolta: contiene consumi per persona e per
# sessione. E' un trattamento di dati dei lavoratori, non un file di lavoro.
cm-team.db
cm-team.db-wal
cm-team.db-shm
*.db
*.db-wal
*.db-shm

# Chiave di pseudonimizzazione. Va custodita SEPARATA dall'archivio: e' l'unica
# cosa che permette di risalire dai codici alle persone. Insieme in un repo
# sarebbe come lasciare la chiave nella toppa.
*.key

# Sistema operativo / editor
Thumbs.db
desktop.ini
.DS_Store
.idea/
*.swp
