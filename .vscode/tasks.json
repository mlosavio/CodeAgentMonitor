{
  "version": "2.0.0",
  "inputs": [
    {
      "id": "sessionId",
      "type": "promptString",
      "description": "UUID della sessione (basta il prefisso, es. a1b2c3d4)"
    }
  ],
  "tasks": [
    {
      "label": "cam: GUI",
      "type": "shell",
      "command": "pythonw",
      "args": ["cam_gui.py"],
      "options": { "cwd": "${workspaceFolder}" },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "reveal": "never",
        "panel": "dedicated",
        "close": true
      },
      "detail": "Apre la finestra del monitor senza console"
    },
    {
      "label": "cam: GUI (console)",
      "type": "shell",
      "command": "python",
      "args": ["cam_gui.py"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "detail": "Come sopra ma con la console visibile, per vedere i traceback"
    },
    {
      "label": "cam: watch",
      "type": "shell",
      "command": "python",
      "args": ["cam.py", "--watch", "--interval", "3"],
      "options": { "cwd": "${workspaceFolder}" },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true,
        "group": "monitor"
      },
      "detail": "Cruscotto live nel terminale, da tenere accanto al panel di Claude Code"
    },
    {
      "label": "cam: per progetto (7g)",
      "type": "shell",
      "command": "python",
      "args": ["cam.py", "--by-project", "--since", "7d"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "group": { "kind": "build", "isDefault": true },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "detail": "Totali per progetto dell'ultima settimana (Ctrl+Shift+B)"
    },
    {
      "label": "cam: sessione…",
      "type": "shell",
      "command": "python",
      "args": ["cam.py", "--session", "${input:sessionId}", "--top", "0"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "detail": "Dettaglio turno per turno di una sessione"
    },
    {
      "label": "cam: svuota cache",
      "type": "shell",
      "command": "python",
      "args": ["cam.py", "--clear-cache"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "shared" },
      "detail": "Forza una riscansione completa dei transcript al prossimo avvio"
    }
  ]
}
